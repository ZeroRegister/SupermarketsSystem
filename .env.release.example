# Copy this file to .env.release and replace every placeholder.
# The image prefix must match the GitHub Container Registry owner/repository.
SHELFWISE_IMAGE_PREFIX=ghcr.io/your-github-owner/shelfwise
SHELFWISE_IMAGE_TAG=latest
# These are GHCR mirrors published by the repository workflow. They avoid a
# Docker Hub dependency during recipient deployment.
SHELFWISE_MYSQL_IMAGE=ghcr.io/your-github-owner/shelfwise/mysql:8.4.8
SHELFWISE_REDIS_IMAGE=ghcr.io/your-github-owner/shelfwise/redis:7.4.9-alpine
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_PASSWORD=replace-with-a-strong-app-password
DEMO_PASSWORD=replace-with-a-local-demo-password
DEMO_ENABLED=true
SESSION_COOKIE_SECURE=false
